<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>all user display</title>
    <style>
        table, th, td {
            border: 1px solid black;
            border-collapse: collapse;
        }
        th, td {
            padding: 10px;
        }
    </style>
</head>
<body>
    <form action="/user/new" method="get">
        <button type="submit"> Add New User</button>
    </form>
    <table>
        <tr>
            <th>Id</th>
            <th>Email</th>
            <th>Username</th>
        </tr>
        <%for(user of users){%>
    <tr>
        <td><%= user.id %></td>
        <td><%= user.email %></td>
        <td><%= user.username %></td>
        <td>
            <form action="/user/<%= user.id %>/edit" method="GET">
                <button>Edit Username</button>
            </form>
        </td>
        <td>
            <form action="/user/<%=user.id%>/delete" method="get">
                <button>Delete User</button>
            </form>
        </td>
    </tr>
<%}%>

    </table>
</body>
</html>
