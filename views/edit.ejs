<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit user name</title>
</head>
<body>
    <h2>you are about to edit this user : <%=user.email%></h2>
    <form action="/user/<%=user.id %>?_method=DELETE" method="post">
    <textarea name="username" id=""><%=user.username%></textarea>
    <input type="password" name="password" id="" placeholder="enter password to confirm changes">
    <button>Edit</button>
    </form>
</body>
</html>