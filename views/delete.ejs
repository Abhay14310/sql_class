<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete User</title>
</head>
<body>
    <h1>Are you sure you want to delete the user?</h1>
    <form action="/user/<%=user.id %>?_method=DELETE" method="POST">
        <input type="email" name="email" id="" placeholder="enter email to confirm deletion">
        <input type="password" name="password" id="" placeholder="enter password to confirm deletion">
        <button type="submit">Yes, delete user</button>
    </form>
    
    
</body>
</html>